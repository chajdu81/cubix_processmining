            "source": [
                "select country, year(signup_date) as signup_year, count(*) as customer_count_per_country\r\n",
                "from sql_recap.dbo.customers\r\n",
                "group by country, year(signup_date)\r\n",
                "having year(signup_date) = '2021'\r\n",
