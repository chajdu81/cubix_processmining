<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                  xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
                  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
                  xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
                  id="Definitions_1"
                  targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:process id="CustomerInvoiceProcess" isExecutable="false">
    <bpmn:startEvent id="StartEvent" name="Start"/>
    <bpmn:task id="Task_InvoiceEntry" name="Invoice Entry"/>
    <bpmn:task id="Task_CheckPayment" name="Check Customer Payment"/>
    <bpmn:exclusiveGateway id="Gateway_PaymentCheck" name="Payment OK?"/>
    <bpmn:endEvent id="EndEvent_Paid" name="End (Paid)"/>
    <bpmn:task id="Task_CreditMemo" name="Credit Memo Entry"/>
    <bpmn:task id="Task_Refund" name="Refund Customer"/>
    <bpmn:task id="Task_ReissueInvoice" name="Re-issuing the Invoice"/>
    <bpmn:endEvent id="EndEvent_Reissue" name="End (Reissued)"/>

    <bpmn:sequenceFlow id="flow1" sourceRef="StartEvent" targetRef="Task_InvoiceEntry"/>
    <bpmn:sequenceFlow id="flow2" sourceRef="Task_InvoiceEntry" targetRef="Task_CheckPayment"/>
    <bpmn:sequenceFlow id="flow3" sourceRef="Task_CheckPayment" targetRef="Gateway_PaymentCheck"/>
    <bpmn:sequenceFlow id="flow4" sourceRef="Gateway_PaymentCheck" targetRef="EndEvent_Paid"/>
    <bpmn:sequenceFlow id="flow5" sourceRef="Gateway_PaymentCheck" targetRef="Task_CreditMemo"/>
    <bpmn:sequenceFlow id="flow6" sourceRef="Task_CreditMemo" targetRef="Task_Refund"/>
    <bpmn:sequenceFlow id="flow7" sourceRef="Task_Refund" targetRef="Task_ReissueInvoice"/>
    <bpmn:sequenceFlow id="flow8" sourceRef="Task_ReissueInvoice" targetRef="EndEvent_Reissue"/>
  </bpmn:process>

  <bpmndi:BPMNDiagram id="BPMNDiagram_1">
    <bpmndi:BPMNPlane id="BPMNPlane_1" bpmnElement="CustomerInvoiceProcess">
      <bpmndi:BPMNShape id="StartEvent_shape" bpmnElement="StartEvent">
        <dc:Bounds x="100" y="100" width="36" height="36"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_InvoiceEntry_shape" bpmnElement="Task_InvoiceEntry">
        <dc:Bounds x="160" y="90" width="100" height="56"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_CheckPayment_shape" bpmnElement="Task_CheckPayment">
        <dc:Bounds x="280" y="90" width="140" height="56"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gateway_PaymentCheck_shape" bpmnElement="Gateway_PaymentCheck" isMarkerVisible="true">
        <dc:Bounds x="440" y="100" width="50" height="50"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="EndEvent_Paid_shape" bpmnElement="EndEvent_Paid">
        <dc:Bounds x="520" y="105" width="36" height="36"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_CreditMemo_shape" bpmnElement="Task_CreditMemo">
        <dc:Bounds x="440" y="180" width="120" height="56"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_Refund_shape" bpmnElement="Task_Refund">
        <dc:Bounds x="580" y="180" width="120" height="56"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_ReissueInvoice_shape" bpmnElement="Task_ReissueInvoice">
        <dc:Bounds x="720" y="180" width="140" height="56"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="EndEvent_Reissue_shape" bpmnElement="EndEvent_Reissue">
        <dc:Bounds x="880" y="190" width="36" height="36"/>
      </bpmndi:BPMNShape>

      <bpmndi:BPMNEdge id="flow1_di" bpmnElement="flow1">
        <di:waypoint x="136" y="118"/>
        <di:waypoint x="160" y="118"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow2_di" bpmnElement="flow2">
        <di:waypoint x="260" y="118"/>
        <di:waypoint x="280" y="118"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow3_di" bpmnElement="flow3">
        <di:waypoint x="420" y="118"/>
        <di:waypoint x="440" y="118"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow4_di" bpmnElement="flow4">
        <di:waypoint x="490" y="118"/>
        <di:waypoint x="520" y="118"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow5_di" bpmnElement="flow5">
        <di:waypoint x="465" y="150"/>
        <di:waypoint x="500" y="180"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow6_di" bpmnElement="flow6">
        <di:waypoint x="560" y="208"/>
        <di:waypoint x="580" y="208"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow7_di" bpmnElement="flow7">
        <di:waypoint x="700" y="208"/>
        <di:waypoint x="720" y="208"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow8_di" bpmnElement="flow8">
        <di:waypoint x="860" y="208"/>
        <di:waypoint x="880" y="208"/>
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
